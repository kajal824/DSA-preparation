class Solution {
    public int maxIceCream(int[] costs, int coins) {

        Arrays.sort(costs);

        int count =0;
        int sum = 0;


        for(int i=0; i<costs.length; i++){

            if(costs[i]>coins){

                return count;
            }
            else if( costs[i]< coins){

                sum +=costs[i];

                count++;

                if(sum>coins){

                    count--;
                    
                    sum -= costs[i];

                    break;
                }



                if(sum == coins ){

                    return count;
                }


            }

                



            
            
           
            
        }

        return count;
       


        
    }
}