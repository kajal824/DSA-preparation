
// S.C: O(nlogn)

// T.C: O(1)




class Solution {
    public boolean asteroidsDestroyed(int mass, int[] asteroids) {

        Arrays.sort(asteroids);

        int n = asteroids.length;

        long sum= mass;


        for(int i =0; i<n; i++){

            if(sum>=asteroids[i]){

             sum += asteroids[i];

                
            }else{

                return false;
            }

           
            

        }

        return true;
        
    }
}