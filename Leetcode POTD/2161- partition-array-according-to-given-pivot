

//T.C: O(n)

//S.C:O(1)






class Solution {
    public int[] pivotArray(int[] nums, int pivot) {
        int n = nums.length;
        
        int [] ans = new int[n];

        int st = 0;
        int ed = n-1;

        

        for(int i=0 , j = n- 1; i<n; i++, j--){

            if(nums[i]<pivot){
                ans[st++] = nums[i];

                
            } if(nums[j]>pivot){
                ans[ed--] = nums[j];
            }
           

            

            
        }

        while(st <= ed){

         ans[st++] = pivot;
        }

        return ans;



       
    }

}