//T.C: O((num2 - num1 + 1) * D)

//S.C: O(1)



class Solution {
    public int totalWaviness(int num1, int num2) {
        int total = 0;
        
        
        for (int i = num1; i <= num2; i++) {
            total += calculateWaviness(i);
        }
        
        return total;
    }
    
    private int calculateWaviness(int x) {
        
        int[] digits = new int[15]; 
        int len = 0;
        
       
        while (x > 0) {
            digits[len++] = x % 10;
            x /= 10;
        }
        
        
        if (len < 3) {
            return 0;
        }
        
        int waviness = 0;
        
        
        for (int i = 1; i < len - 1; i++) {
            boolean isPeak = digits[i] > digits[i - 1] && digits[i] > digits[i + 1];
            boolean isValley = digits[i] < digits[i - 1] && digits[i] < digits[i + 1];
            
            if (isPeak || isValley) {
                waviness++;
            }
        }
        
        return waviness;
    }
}