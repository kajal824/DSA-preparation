
//T.C : O(1)

//S.C : O(1)



class Solution {
    public double angleClock(int hour, int minutes) {


        double ans =0;

        double  hrshand = 30*hour + 0.5*minutes;

        double minhand = 0*hour + 6*minutes;

        ans = Math.abs(hrshand - minhand);

        return Math.min(ans,360-ans);
        
    }
}