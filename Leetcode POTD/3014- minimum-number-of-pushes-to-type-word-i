class Solution {
    public int minimumPushes(String word) {

        int n = word.length();

        int cnt = 0;
        if(n<=8){
            return n;
        }else if(n<=16){
            cnt = 8+(n-8)*2;
        }else if(n<=24){
            cnt = 24+(n-16)*3;
        }else{

            cnt = 48+ (n-24)*4;
        }
        return cnt;

        
        
    }
}