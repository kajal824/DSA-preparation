
//T.C: O(n^2)

//S.C: O(1)




class Solution {
    public int earliestFinishTime(int[] landStartTime, int[] landDuration, 
                                  int[] waterStartTime, int[] waterDuration) {
        int minTotalTime = Integer.MAX_VALUE;
        
        
        for (int i = 0; i < landStartTime.length; i++) {
            for (int j = 0; j < waterStartTime.length; j++) {
                
                
                int landEnd = landStartTime[i] + landDuration[i];
                int order1Finish = Math.max(landEnd, waterStartTime[j]) + waterDuration[j];
                
                
                int waterEnd = waterStartTime[j] + waterDuration[j];
                int order2Finish = Math.max(waterEnd, landStartTime[i]) + landDuration[i];
                
               
                minTotalTime = Math.min(minTotalTime, Math.min(order1Finish, order2Finish));
            }
        }
        return minTotalTime;
    }
}