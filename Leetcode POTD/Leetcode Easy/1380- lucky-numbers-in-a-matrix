class Solution {
    public List<Integer> luckyNumbers(int[][] matrix) {
        int  m= matrix.length;
        int n = matrix[0].length;
       
        

        List<Integer> rm = new ArrayList<>();

        for(int i=0; i<m; i++){

             int mn = Integer.MAX_VALUE;

             for(int j=0; j<n; j++){

                mn = Math.min(mn, matrix[i][j]);


             }

              rm.add(mn);

             
            

        }

        List<Integer> cm = new ArrayList<>();

        for(int i=0; i<n; i++){

             int mx = Integer.MIN_VALUE;

             for(int j=0; j<m; j++){
                
                mx = Math.max(mx, matrix[j][i]);
             }

             cm.add(mx);




        }
        List<Integer> lc = new ArrayList<>();
        for(int i=0; i<m; i++){
            for(int j=0; j<n ; j++){

                if(matrix[i][j]==rm.get(i) && matrix[i][j]==cm.get(j)){

                    lc.add(matrix[i][j]);
                }
            }
        }

        return lc;


        

         
       
        
    }
}