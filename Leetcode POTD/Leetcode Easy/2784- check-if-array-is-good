class Solution {
    public boolean isGood(int[] nums) {
        int n = nums.length;
       
        int maxVal = n - 1;
        
      
        int[] counts = new int[n]; 
        for (int x : nums) {
            
            if (x < 1 || x > maxVal) return false;
            counts[x]++;
        }

        
        for (int i = 1; i < maxVal; i++) {
            if (counts[i] != 1) return false;
        }

        
        return counts[maxVal] == 2;
    }
}