
//T.C:O(N)

//S.C:O(N


class Solution {
    public String removeDuplicates(String s) {

        StringBuilder ans = new StringBuilder();

        for( char ch : s.toCharArray() ){


            
             if( ans.length() >0 && ch == ans.charAt(ans.length()-1)){

                ans.deleteCharAt(ans.length()-1);
            }else{

                ans.append(ch);
            }


            
        }

        return ans.toString(); 
        
    }
}