class Solution {
    public int countValidPrefixes(String s) {

        int vc = 0;
        int cnt0 = 0;
        int cnt1= 0;

        for(char ch : s.toCharArray()){
            if(ch=='0'){
                cnt0++;
            }else{
                cnt1++;
            }

            if(Math.abs(cnt0-cnt1)<=1){
                vc++;
            }
        }
        return vc;
        
    }
}