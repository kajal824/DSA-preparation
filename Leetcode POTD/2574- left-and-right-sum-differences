
 // T.C :O(N)

 //S.C: O(1)


class Solution {
    public int[] leftRightDifference(int[] nums) {

        int n = nums.length;
        int[] ar = new int[n];

        int leftsum= 0;
        int rightsum =0;

        for(int i =0; i<n;i++){
            rightsum += nums[i];

        }
        for(int i=0; i<n;i++){

            rightsum -= nums[i];

            ar[i] = Math.abs(leftsum - rightsum);

            leftsum += nums[i];
             
        }


       

        return ar;
        
    }
}