

//T.C : O(N)

//S.C: O(1)




class Solution {
    public long maxTotalValue(int[] nums, int k) {

        long mx = Integer.MIN_VALUE;
        long mn = Integer.MAX_VALUE;

        

        


        for(int num : nums ){

            mx= Math.max(mx, num);

            mn = Math.min(mn, num);

            


        }

        return (mx - mn) * k;
        
    }
}