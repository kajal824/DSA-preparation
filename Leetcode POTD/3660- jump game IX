// T.c: O(n)
// S.C : O(n) 



class Solution {
    public int[] maxValue(int[] nums) {

        int n = nums.length;
        int[] leftside = new int[n];
         int[] rightside = new int[n];

         leftside[0] = nums[0];
         rightside[n-1] = nums[n-1];

         for(int i = 1; i < n; i++) {
            leftside[i] = Math.max(nums[i], leftside[i - 1]);
        }

        for(int i = n - 2; i >= 0; i--) {
            rightside[i] = Math.min(nums[i], rightside[i + 1]);
        }

        int[] ans = new int[n];

        ans[n - 1] = leftside[n - 1];

        for(int i = n - 2; i >= 0; i--) {
            if(leftside[i] <= rightside[i + 1]) { 
                ans[i] = leftside[i];
            } else {
                ans[i] = ans[i + 1];
            }
        }

        return ans;
    }
}


        

        

        
    