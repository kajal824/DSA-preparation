//T.C: O(nlogn)

// S.C: O(1)




class Solution {
    public int minimumCost(int[] cost) {

        Arrays.sort(cost);

        int ttc = 0;
        int n = cost.length;

        for(int i = n-1; i>=0; i--){
            ttc += cost[i];
            i--;
            if(i>=0){

            ttc += cost[i];
            i--;


        }

        }

        
        return ttc;
        
    }
}