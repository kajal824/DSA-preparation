// T.C : O(n)






class Solution {
    public int[] findThePrefixCommonArray(int[] A, int[] B) {

        int n = A.length;

        int[] freq = new int[n+1];
        int[] ans = new int[n];

        int commn = 0;

        
       

        for(int i=0; i<n; i++){


            freq[A[i]]++;

            if(freq[A[i]]==2){
                
                commn++;
            }

            freq[B[i]]++;

            if(freq[B[i]]==2){

                commn++;
            }

            ans[i] = commn;

            

                
        }
        return ans;
        
    }
}