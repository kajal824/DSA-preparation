class Solution {
    public List<List<Integer>> findPrimePairs(int n) {

        List<List<Integer>> ans = new ArrayList<>();

       
        boolean[] prime = new boolean[n + 1];

        Arrays.fill(prime, true);

        prime[0] = false;
        prime[1] = false;

        for (int i = 2; i * i <= n; i++) {

            if (prime[i]) {

                for (int j = i * i; j <= n; j += i) {
                    prime[j] = false;
                }
            }
        }

        
        int l = 2;
        int r = n;

        while (l <= r) {

            if (prime[l] && prime[r]) {

                if (l + r == n) {
                    ans.add(Arrays.asList(l, r));
                    l++;
                    r--;
                }
                else if (l + r < n) {
                    l++;
                }
                else {
                    r--;
                }

            }
            else if (!prime[l]) {
                l++;
            }
            else {
                r--;
            }
        }

        return ans;
    }
}