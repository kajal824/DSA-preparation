// T.C: O(n)

// S.C: O(n)



class Solution {
    public int passwordStrength(String password) {

        Set<Character> fnd = new HashSet<>();
        int ttl = 0;
        for (char c : password.toCharArray()) {

            if (fnd.add(c)) {

                if (c >= 'a' && c <= 'z') {

                    ttl += 1;
                } else if (c >= 'A' && c <= 'Z') {

                    ttl += 2;
                } else if (c >= '0' && c <= '9') {

                    ttl += 3;
                } else if ("!@#$".indexOf(c) != -1) {
                    ttl += 5;
                }

            }

        }

        return ttl;

    }
}