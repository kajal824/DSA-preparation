class Solution {
    public long maxSum(int[] nums, int k, int mul) {

        Arrays.sort(nums);

        long ttl = 0;
        int n = nums.length;
        for(int i=0; i<k ; i++){
            long ele = nums[n-1-i];
            long cm = Math.max(1,(long) mul-i);

            ttl += ele *cm;
        }

        return ttl;
        
    }
}