

//T.C: O(n)

//S.C: O(1)




class Solution {
    public int getLength(int[] nums) {

        int ml = 1;

        int n = nums.length;

        if (n <= 1) {
            return n;
        }

        for (int i = 0; i < n; i++) {

            Map<Integer, Integer> ct = new HashMap<>();
            Map<Integer, Integer> fm = new HashMap<>();

            int mf = 0;

            for (int j = i; j < n; j++) {
                int val = nums[j];

                int odf = ct.getOrDefault(val, 0);
                int newf = odf + 1;

                ct.put(val, newf);

                if (odf > 0) {
                    fm.put(odf, fm.getOrDefault(odf, 0) - 1);

                    if (fm.get(odf) == 0) {

                        fm.remove(odf);
                    }

                }
                fm.put(newf, fm.getOrDefault(newf,0) +1);

                mf = Math.max(mf, newf);

                if (ct.size() == 1) {

                    ml = Math.max(ml, j - i + 1);

                } else if (fm.size() == 2) {
                    if (mf % 2 == 0 && fm.containsKey(mf / 2)) {

                        ml = Math.max(ml, j-i + 1);
                    }
                }

            }

        }
        return ml;

    }
}