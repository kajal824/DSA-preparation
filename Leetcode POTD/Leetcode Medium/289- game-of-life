class Solution { 
    public void gameOfLife(int[][] board) { 
        int m = board.length; 
        int n = board[0].length; 
        int[][] copyBoard = new int[m][n];
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                copyBoard[i][j] = board[i][j];
            }
        }

        for (int i = 0; i < m; i++) { 
            
            for (int j = 0; j < n; j++) { 
                int cnt = 0; 
                
                for (int k = i - 1; k <= i + 1; k++) { 
                   
                    for (int l = j - 1; l <= j + 1; l++) { 
                        
                        
                        if (k >= 0 && k < m && l >= 0 && l < n && !(k == i && l == j)) {
                           
                            if (copyBoard[k][l] == 1) { 
                                cnt++; 
                            } 
                        }
                    } 
                } 
                
               
                if (copyBoard[i][j] == 1) {
                    if (cnt < 2 || cnt > 3) {
                        board[i][j] = 0; 
                    }
                } else {
                    if (cnt == 3) {
                        board[i][j] = 1; 
                    }
                }
            } 
        } 
    } 
}