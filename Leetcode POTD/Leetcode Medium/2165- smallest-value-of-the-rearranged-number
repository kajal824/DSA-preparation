class Solution {
    public long smallestNumber(long num) {

        boolean isneg = (num<0);

        num = Math.abs(num);

        char[] ch = (""+num).toCharArray();
        long ans = 0;

        Arrays.sort(ch);

        if(isneg){
            String ast = "";

            for(int i = ch.length-1; i>=0;i--){
                ast +=ch[i];
            }
            ans = -Long.parseLong(ast);

        }else{
            int i=0;
            for( i=0; i<ch.length; i++){

                if(ch[i]!='0'){
                    break;

                }

            }

            if(i<=(ch.length-1)){
                char tem = ch[i];
                ch[i] = ch[0];
                ch[0]= tem;
            }

            String res = String.valueOf(ch);
            ans = Long.parseLong(res);
        } 
        return ans;
        
    }
}