class Solution {
    public double minPrice(int[] prices, int[] discounts) {

        Arrays.sort(prices);
        Arrays.sort(discounts);

        double ttl = 0.0;
        int pl = prices.length;
        int dl = discounts.length;

        for(int i=0; i<pl; i++){
            int pi = pl-1-i;
            int di = dl-1-i;

            if(di>=0){
                ttl += (prices[pi]*(100.0-discounts[di]))/100;
            }else{
                ttl += prices[pi];
            }
        }
        return ttl;
        
    }
}