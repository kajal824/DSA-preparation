


class Solution {
    public int compress(char[] chars) {

        int readindex= 0;

        int writeindex =0;

        while(readindex < chars.length){

            char cc = chars[readindex];

            int count =0;

            while(readindex < chars.length && cc == chars[readindex]){

                readindex++;

                count++;
            }

            chars[writeindex++] = cc;

            if(count >1){

                String sc = String.valueOf(count);

                for( char ch : sc.toCharArray()) {
                    chars[writeindex] = ch;

                    writeindex++;
                }
            }

        }

        return writeindex;

        
    }
}